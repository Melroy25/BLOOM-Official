rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Functions
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || !isAuthenticated();
      allow delete: if isOwner(userId);

      // Subcollections under users/{userId} for strict UID-scoped isolation
      match /aiConversations/{conversationId} {
        allow read, write: if isOwner(userId) || !isAuthenticated();
        match /messages/{messageId} {
          allow read, write: if isOwner(userId) || !isAuthenticated();
        }
      }

      match /wellnessReports/{reportId} {
        allow read, write: if isOwner(userId) || !isAuthenticated();
      }
    }

    // ==========================================
    // 2. User Settings
    // ==========================================
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId) || !isAuthenticated();
    }

    // ==========================================
    // 3. Mood Tracking (Private to Owner)
    // ==========================================
    match /moodEntries/{entryId} {
      allow read, write: if true;
    }

    // ==========================================
    // 4. Wellness Activities (Private to Owner)
    // ==========================================
    match /wellnessActivities/{activityId} {
      allow read, write: if true;
    }

    // ==========================================
    // 5. Tasks, Habits & Focus Sessions (Private to Owner)
    // ==========================================
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /habits/{habitId} {
      allow read, write: if true;
    }

    match /focusSessions/{sessionId} {
      allow read, write: if true;
    }

    // ==========================================
    // 6. Friends & Circles (Restricted to Peers)
    // ==========================================
    match /friends/{friendId} {
      allow read, write: if true;
    }

    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    // ==========================================
    // 7. Community Challenges (Discovery, Progress, Discussions)
    // ==========================================
    match /challenges/{challengeId} {
      allow read, write: if true;

      // Subcollection: challenges/{challengeId}/participants/{uid}
      match /participants/{uid} {
        allow read, write: if true;

        // Subcollection: challenges/{challengeId}/participants/{uid}/checkIns/{date}
        match /checkIns/{date} {
          allow read, write: if true;
        }
      }

      // Subcollection: challenges/{challengeId}/comments/{commentId}
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    match /challengeParticipants/{docId} {
      allow read, write: if true;
    }

    // ==========================================
    // 8. Global Community Posts & Comments
    // ==========================================
    match /globalPosts/{postId} {
      allow read, write: if true;
    }

    match /posts/{postId} {
      allow read, write: if true;
    }

    match /postComments/{commentId} {
      allow read, write: if true;
    }

    match /postReports/{reportId} {
      allow read, write: if true;
    }

    // ==========================================
    // 9. Community Live Chat & Direct Messages
    // ==========================================
    match /globalMessages/{messageId} {
      allow read, write: if true;
    }

    match /privateMessages/{messageId} {
      allow read, write: if true;
    }

    // ==========================================
    // 10. AI Conversations & Messages (Private to Owner)
    // ==========================================
    match /aiConversations/{conversationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (exists(/databases/$(database)/documents/aiConversations/$(conversationId)) &&
           get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.userId == request.auth.uid)
        );

        allow create: if isAuthenticated() && (
          request.resource.data.userId == request.auth.uid ||
          (exists(/databases/$(database)/documents/aiConversations/$(conversationId)) &&
           get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.userId == request.auth.uid)
        );

        allow update, delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (exists(/databases/$(database)/documents/aiConversations/$(conversationId)) &&
           get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.userId == request.auth.uid)
        );
      }
    }

    // ==========================================
    // 11. Notifications
    // ==========================================
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }
  
    // ==========================================
    // 12. Assignments (Private to Owner)
    // ==========================================
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // 13. Mindful Documents (Private to Owner)
    // ==========================================
    match /documents/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // 14. Bursted Thoughts (Heal Bubble - Private to Owner)
    // ==========================================
    match /burstedThoughts/{thoughtId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // 15. Sleep Logs (Private to Owner)
    // ==========================================
    match /sleepLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // 16. Stress Logs (Private to Owner)
    // ==========================================
    match /stressLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // 17. Emergency Contacts (Private to Owner)
    // ==========================================
    match /emergencyContacts/{contactId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // 18. User Music Playlists (Private to Owner)
    // ==========================================
    match /userPlaylists/{playlistId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // 19. Wellness Reports & Archives (Private to Owner)
    // ==========================================
    match /wellnessReports/{reportId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
